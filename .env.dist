# Copy to .env on the Pi and fill in. Never commit the real .env.
#   cp .env.dist .env && nano .env

# --- Database -------------------------------------------------------------
POSTGRES_DB=webhookcity
POSTGRES_USER=webhookcity
# Required. Generate one: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- API ------------------------------------------------------------------
# Host port for the API. 5000 is already taken by the invoicer API on the Pi.
API_PORT=5001

# Required. Signing key for access tokens (min 32 chars).
# Generate one: openssl rand -base64 48
JWT_KEY=

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# Frontend and API are both subdomains of the same registrable domain
# (e.g. webhookcity.bmball.com + webhooks-api.bmball.com), so they are
# "same-site" and the refresh cookie can use the stricter, more reliable Lax.
# Only use None if the frontend lives on a different domain (e.g. a raw
# *.netlify.app URL) — None depends on third-party cookies, which Safari and
# Chrome increasingly block, causing users to appear randomly signed out.
JWT_COOKIE_SAMESITE=Lax
# TLS is terminated by the Cloudflare tunnel in front of Kestrel.
JWT_COOKIE_SECURE=true

# Required. Comma-separated list of allowed frontend origins — no trailing slash.
# e.g. https://webhookcity.bmball.com
CORS_ORIGINS=

# Self-service sign-up. Leave false so strangers cannot create accounts on your
# public URL. Flip to true (and restart the api) only while inviting someone,
# then set it back. The first-ever account is always allowed regardless, so a
# fresh install can still be bootstrapped.
ALLOW_REGISTRATION=false
