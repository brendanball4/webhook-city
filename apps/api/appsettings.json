{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=webhookcity;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "_comment": "DEVELOPMENT PLACEHOLDER. Override with the Jwt__Key environment variable before deploying anywhere real.",
    "Key": "dev-only-insecure-signing-key-change-me-32b+",
    "Issuer": "webhook-city",
    "Audience": "webhook-city",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  }
}
